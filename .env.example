# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/aagara?replicaSet=rs0
SYNC_INDEXES=true

# JWT Secrets (minimum 32 characters)
JWT_ACCESS_SECRET=aagara_thirupthi_jwt_access_secret_super_secure_key_2026_dev
JWT_REFRESH_SECRET=aagara_thirupthi_jwt_refresh_secret_super_secure_key_2026_dev
ACCESS_TOKEN_TTL_PROVIDER=15m
ACCESS_TOKEN_TTL_USER=30d
REFRESH_TOKEN_TTL_DAYS=30

# Document Encryption Key (AES-256-GCM, 32 bytes base64)
DOC_ENCRYPTION_KEY=c29tZXNlY3JldGtleWZvcmFlc2djbTI1NmJpdGtleSE=

# CORS
CORS_ORIGINS=https://test-three-mu-12.vercel.app,https://aagarathirupthiprovider.vercel.app,http://localhost:8081,http://localhost:19006,http://localhost:3000

# OTP Configuration
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS=3
OTP_WINDOW_MINUTES=15
OTP_MAX_ATTEMPTS=5

# SMS Adapter (console | msg91 | fast2sms | twilio)
SMS_DRIVER=console
SMS_NOTIFY_QUOTES=false

# Media & Storage (local | s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
CDN_BASE_URL=http://localhost:4000/static/uploads
ALLOW_EXTERNAL_IMAGE_URLS=true

# AWS S3 (when STORAGE_DRIVER=s3)
S3_BUCKET=aagara-media
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@aagarathirupthi.com
ADMIN_PASSWORD=Admin@Aagara2026!

# Business Constants
PLATFORM_COMMISSION_PERCENT=0
JOBS_ENABLED=true
LOG_LEVEL=info
